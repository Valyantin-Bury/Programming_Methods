#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

int main() 
{
    std::setlocale(LC_ALL, "russian");
    int a, b, j{ 2 }, k{ 0 };

    std::cout << "Введите числа A, B" << '\n';
    std::cin >> a;
    std::cin >> b;
    
    while (a < b) {
        j = 2;
        while (a > j) {
            if (a % j == 0) {
                k = 1;
                break;
            }
            j++;
        }
        
        if (k == 0) {
            std::cout << a << ' ';
        } else {
            k = 0;
        }
        
        a++;
    }

    return 0;
}
