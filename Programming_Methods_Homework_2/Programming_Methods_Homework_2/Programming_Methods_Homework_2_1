#include <iostream>

using namespace std;

int main() 
{
    for (int i{ 0 }; i < 8; i++) {
        std::cout << "\n";
        for (int j{ 0 }; j < 8; j++) {
            if ((i + j) % 2 == 0) {
                std::cout << "." << " ";
            } else {
                std::cout << "+" << " ";
            }
        }
    }
    
    return 0;
}
// 8x8 chess grid
