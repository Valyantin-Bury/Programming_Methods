#include <iostream>
#include <string>

const int SIZE{ 101 };

int main()
{
    std::setlocale(LC_ALL, "russian");
    std::cout << "Максимальный размер массива 100" << '\n';
    int mus[SIZE]{ 0 };
    int a;
    int b;
    std::cin >> a;
    for (int i{ 0 }; i < a; i++) {
        std::cin >> mus[i];
    }
    std::cout << "Введите значение котороё ищут" << '\n';
    std::cin >> b;

    for (int i{ 0 }; i < a; i++) {
        if (b == mus[i]) {
            b = i;
            break;
        }
    }

    for (int i{ b }; i < a; i++) {
        mus[i] = mus[i + 1];
    }

    for (int i{ 0 }; i < a - 1; i++) {
        std::cout << mus[i] << ' ';
    }

    return 0;
}
