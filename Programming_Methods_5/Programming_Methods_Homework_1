#include <iostream>
using namespace std;

const int SIZE = 12;

void color(int a) {
    switch (a) {
        case 1:
            cout << "\033[41m  \033[0m";
            break;
        case 2:
            cout << "\033[44m  \033[0m";
            break;
        case 3:
            cout << "\033[42m  \033[0m";
            break;
        default:
            cout << ". ";
            break;
    }
}

// Общая функция отрисовки холста
void drawCanvas(int canvas[][SIZE], int a) {
    for (int i{0}; i < SIZE; i++) {
        for (int j{0}; j < SIZE; j++) {
            if (canvas[i][j] == 1) {
                color(a);
            } else {
                cout << "  ";
            }
        }
        cout << endl;
    }
    cout << endl;
}

void rectangle(int canvas[][SIZE], int a) {
    for (int i{0}; i < SIZE; i++) {
        for (int j{0}; j < SIZE; j++) {
            canvas[i][j] = 1; 
        }
    }
    drawCanvas(canvas, a);
}

void line(int canvas[][SIZE], int a) { 
    for (int i{0}; i < SIZE; i++) {
        for (int j{0}; j < SIZE; j++) {
            canvas[i][j] = (i == j) ? 1 : 0; // 1 — рисуем, 0 — пусто
        }
    }
    drawCanvas(canvas, a);
}

void circle(int canvas[][SIZE], int a) {
    int center2 = SIZE - 1;
    for (int i{0}; i < SIZE; i++) {
        for (int j{0}; j < SIZE; j++) {
            int dy = 2 * i - center2;
            int dx = 2 * j - center2;
            int distSq = dx * dx + dy * dy;

            canvas[i][j] = (distSq < 144) ? 1 : 0;
        }
    }
    drawCanvas(canvas, a);
}

int main() {
    int canvas[SIZE][SIZE]{0};
    int a;

    cout << "1 - red; 2 - blue; 3 - green." << endl;
    cin >> a;
    cout << endl;

    rectangle(canvas, a);
    circle(canvas, a);
    line(canvas, a);

    return 0;
}
