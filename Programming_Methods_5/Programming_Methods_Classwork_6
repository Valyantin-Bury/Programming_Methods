#include <iostream>
#include <string>

const int SIZE{ 101 };

int main()
{
    std::setlocale(LC_ALL, "russian");
    std::cout << "Максимальный размер массива 100" << '\n';
    int mus[SIZE]{ 0 };
    int a;
    int b;
    std::cin >> a;
    for (int i{ 0 }; i < a; i++) {
        std::cin >> mus[i];
    }
    if (a % 2 == 0) {
        for (int i{ 0 }; i < a; i = i + 2) {
            b = mus[i];
            mus[i] = mus[i + 1];
            mus[i + 1] = b;
            std::cout << mus[i] << " " << mus[i + 1] << '\n';
        }
    }
    else {
        for (int i{ 0 }; i < a - 1; i = i + 2) {
            b = mus[i];
            mus[i] = mus[i + 1];
            mus[i + 1] = b;
            std::cout << mus[i] << " " << mus[i + 1] << '\n';
        }
        std::cout << mus[a - 1] << '\n';

    }
    return 0;
}
