using namespace std;   
   
   
int main()   
{   
    std::setlocale(LC_ALL, "russian");  
    float a, b, c;  
    std::cout << "Введите 'circle' или 'square' или 'triangle'" << '\n';  
    string fig;  
    std::cin >> fig;  
   
    if (fig == "circle") {  
        std::cout << "Введите радиус" << '\n'; 
        std::cin >> a; 
        std::cout << "Периметр фируы = " << a*3.14*2 << '\n'; 
    }  
