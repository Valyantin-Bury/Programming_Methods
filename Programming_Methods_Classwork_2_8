#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

int main() 
{
    std::setlocale(LC_ALL, "russian");
    int n, i{ 1 }, j{ 0 }, k{ 1 };

    std::cout << "Введите число n" << '\n';
    std::cin >> n;
    
    if (n > 0) {
        std::cout << "1" << '\n';
    }
    
    while (k < n + 1) {
        j = k;
        while (k > i) {
            if (k % i == 0) {
                j = j - i;
            }
            i++;
        }
        
        if (j == 0) {
            std::cout << k << '\n';
        }
        
        i = 1;
        k++;
    }

    return 0;
}
// Printing perfect numbers from 1 to n
