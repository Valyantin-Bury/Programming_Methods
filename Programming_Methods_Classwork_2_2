#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

int main() 
{
    std::setlocale(LC_ALL, "russian");
    
    int n, i{ 0 }, s{ 0 }, b{ 1 };

    std::cout << "Введите число n" << '\n';
    std::cin >> n;
    
    while (i < n) {
        std::cout << s << ' ';
        s = s + b;
        std::swap(s, b);
        i++;
    }

    return 0;
}
//The Fibonacci sequence
